<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude encrypted prefs from cloud backup; key is device-specific -->
        <exclude domain="sharedpref" path="gemini_prefs.xml"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="gemini_prefs.xml"/>
    </device-transfer>
</data-extraction-rules>
